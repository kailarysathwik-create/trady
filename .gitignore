# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Data directories (keep directory structure via .gitkeep, ignore data contents)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/features/*
!data/features/.gitkeep
data/targets/*
!data/targets/.gitkeep

# Model weights, serialized artifacts, large experiment outputs
models/*
!models/.gitkeep
*.h5
reports/*.pdf
reports/*.html
!reports/.gitkeep
!notebooks/.gitkeep
!scripts/.gitkeep
