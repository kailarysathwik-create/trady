.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
!.env.example
*.key
*.pem
*.secret

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

