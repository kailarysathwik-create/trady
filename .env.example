# ==============================================================================
# TRADY Environment Configuration Example
# Copy this file to .env and adjust variables for your local machine.
# NEVER commit your actual .env file or any secrets to source control.
# ==============================================================================

# Application Environment (development, testing, production)
TRADY_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
TRADY_LOG_LEVEL=INFO

# Structured Logging Format (text, json)
TRADY_LOG_FORMAT=text

# Path to primary configuration file
TRADY_CONFIG_PATH=configs/default.yaml

# Global Random Seed for Deterministic Reproducibility
TRADY_RANDOM_SEED=42

# Target Compute & Hardware Constraints (Lenovo LOQ Optimized Defaults)
TRADY_MAX_WORKERS=4
TRADY_DEVICE=cpu
TRADY_BATCH_SIZE=64

# Safety Guards (Must remain false: TRADY does NOT support real-money execution)
TRADY_LIVE_TRADING_ENABLED=false
TRADY_DISCLAIMER_ACKNOWLEDGED=true
